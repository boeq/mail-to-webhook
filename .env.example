# mail-to-webhook settings. Copy to .env and fill in WEBHOOK_URL at least.
# Every value is optional except WEBHOOK_URL; what is shown is the default.
# docs/configuration.md explains each one.

# --- Where mail goes -----------------------------------------------------------

# REQUIRED. The endpoint that receives each message as JSON.
WEBHOOK_URL=

# HTTP basic auth for the endpoint. Credentials written into the URL
# (https://user:pass@host/path) are moved here automatically.
WEBHOOK_AUTH_USER=
WEBHOOK_AUTH_PASS=

# HMAC key for the X-Mail-To-Webhook-Signature header. Empty sends unsigned
# webhooks and logs a warning at startup. `openssl rand -hex 32`
WEBHOOK_SECRET=

# Extra static request headers: Name=value,Other=value
WEBHOOK_HEADERS=

WEBHOOK_TIMEOUT=20s
# Extra attempts inside the SMTP conversation before the sender is told to retry.
WEBHOOK_RETRIES=2
# Response codes that mean "this message will never be accepted" and bounce it.
# Every other non-2xx answer defers the mail to the sender's queue.
PERMANENT_STATUS_CODES=400,406,410,413,415,422

# A re-send from the UI is retried after 1 min, 5 min, 15 min, 1 h and 6 h.
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_SWEEP_SECONDS=15

# --- Which mail is accepted ----------------------------------------------------

# The domains this server is the final destination for, comma-separated.
# ALWAYS set this in production: empty accepts mail for every domain.
ALLOWED_DOMAINS=
# Optional allowlist of local parts ("inbound,support"); a +suffix is ignored.
ALLOWED_MAILBOXES=

# Ask your application whether an address exists before accepting mail for it.
# Empty turns the check off. See docs/recipient-check.md for the contract.
RECIPIENT_CHECK_URL=
RECIPIENT_CHECK_TIMEOUT=5s
# How long a known address is trusted before it is asked about again.
RECIPIENT_RECHECK=24h
# How long an "unknown" answer is remembered.
RECIPIENT_UNKNOWN_TTL=5m

# Limits. 0 switches one off.
MAX_CONNECTIONS=50
MAX_CONNECTIONS_PER_IP=10
MAX_CONNECTIONS_PER_IP_PER_MINUTE=60
# Unknown recipients on one connection before it is closed with 421.
MAX_BAD_RECIPIENTS=3
# Unknown recipients from one address within 10 minutes before it is blocked.
BLOCK_AFTER_BAD_RECIPIENTS=20
BLOCK_DURATION=15m

# --- SMTP ----------------------------------------------------------------------

SMTP_ADDR=:2525
# The hostname your MX record points to. For more than one, separate them with
# commas: mx.example.org,mx.example.net. The first is announced in the greeting.
SMTP_DOMAIN=inbound.local
MAX_MESSAGE_BYTES=26214400
MAX_RECIPIENTS=50
MAX_LINE_BYTES=1048576
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s

# STARTTLS, in one of two ways.
#
# 1. Automatic. A certificate for each hostname in SMTP_DOMAIN is obtained from
#    Let's Encrypt and renewed in time. Each must be a public hostname of this server,
#    and port 80 of it must reach ACME_HTTP_ADDR: publish "80:8089", or let
#    the web server that holds port 80 forward /.well-known/acme-challenge/.
#    Setting this to true accepts the CA's terms of service.
ACME_ENABLED=false
# Optional contact address for the CA.
ACME_EMAIL=
# Another ACME CA. To try things out, use Let's Encrypt's staging directory:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=
ACME_HTTP_ADDR=:8089
#
# 2. Your own certificate. Set both.
TLS_CERT=
TLS_KEY=

# --- The JSON payload ----------------------------------------------------------

# false: one POST per message. true: one POST per recipient of the message.
PER_RECIPIENT=false
INCLUDE_ATTACHMENTS=true
# Largest attachment forwarded, in bytes. 0 means no limit beyond MAX_MESSAGE_BYTES.
MAX_ATTACHMENT_BYTES=0
# What to do with a larger one: "skip" drops it, "reject" refuses the message.
OVERSIZE_ATTACHMENT_POLICY=skip
DEDUPE_ATTACHMENT_NAMES=true
# Add the full message source as base64 in "RawEmail".
INCLUDE_RAW_EMAIL=false
# The sender used when a message has none that is usable. Default: mailer-daemon@SMTP_DOMAIN
FALLBACK_SENDER=

# Normalisations that keep a strict consumer from rejecting unusual mail.
ENSURE_RECIPIENT_IN_TO=true
SYNTHESIZE_MESSAGE_ID=true
TEXT_FROM_HTML=true
EXPAND_ATTACHED_MESSAGES=true
EXPAND_TNEF=true
# Check each payload against the consumer's rules before posting; on a
# violation the mail is deferred instead of posted and bounced.
STRICT_COMPAT=true

# --- History and the operator UI -----------------------------------------------

DATA_DIR=/data
RETENTION_DAYS=30
# Keep each raw message for RETENTION_DAYS. Needed to re-send and to view content.
STORE_RAW=true

HTTP_ADDR=:8080
UI_ENABLED=true
# Built-in basic auth for the UI. Set both, or put a reverse proxy in front.
UI_AUTH_USER=
UI_AUTH_PASS=

LOG_LEVEL=info
